# Copy to .env only to override the demo defaults. `make demo` needs no .env at all.
#
# Tokens are "token:actor:role". The actor is what the audit trail records, which is
# why rotating a token does not rewrite history.
LIVEOPS_TOKENS=admin-token:em:admin,op-token:ci:operator,view-token:viewer:viewer
LIVEOPS_ENVS=dev,staging,prod
